# ─── Python ──────────────────────────────────────────────────────────────────
__pycache__/
*.py[cod]
*$py.class
*.so

# ─── Virtual environments ────────────────────────────────────────────────────
.venv/
venv/
env/

# ─── Packaging / build output ────────────────────────────────────────────────
build/
dist/
*.egg-info/
*.egg
.eggs/

# ─── Test / lint / type-check caches ─────────────────────────────────────────
.pytest_cache/
.ruff_cache/
.mypy_cache/
.tox/
.nox/
.coverage
.coverage.*
htmlcov/
coverage.xml
junit*.xml

# ─── uv ──────────────────────────────────────────────────────────────────────
# uv.lock IS tracked on purpose (reproducible installs) — do not ignore it.
.uv/

# ─── Pipeline artifacts (regenerated by `fetch` / `score`) ───────────────────
# Raw scrape bodies, JSONL logs, and emitted output are all reproducible from
# a run; they are review inputs, not source.
data/
output/

# ─── Secrets / local environment ─────────────────────────────────────────────
.env
.env.*
!.env.example

# ─── Local configuration ─────────────────────────────────────────────────────
# config.yaml is a personal tuning file (tier lambdas/floors, active hours,
# exclusions, pins, provider on/off) — it changes often and differs per person,
# so it is NOT tracked. The tracked template is config.example.yaml: copy it to
# config.yaml to get started. When you add a key to config.yaml, document it in
# the template too so it never falls behind the loader.
# (The repo-root config.yaml — the LiteLLM router config — stays tracked.)
/config.yaml

# ─── Editor / OS noise ───────────────────────────────────────────────────────
.idea/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~
